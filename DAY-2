mark1 = int(input("Enter mark for Subject 1: "))
mark2 = int(input("Enter mark for Subject 2: "))
mark3 = int(input("Enter mark for Subject 3: "))
mark4 = int(input("Enter mark for Subject 4: "))
mark5 = int(input("Enter mark for Subject 5: "))

total = mark1 + mark2 + mark3 + mark4 + mark5

average = total / 5

print("Total =", total)
print("Average =", average)

if mark1 < 35 or mark2 < 35 or mark3 < 35 or mark4 < 35 or mark5 < 35:
    print("Result: FAIL")
    print("Grade: F")

elif average >= 90:
    print("Result: PASS")
    print("Grade: A+")

elif average >= 80:
    print("Result: PASS")
    print("Grade: A")

elif average >= 70:
    print("Result: PASS")
    print("Grade: B")

elif average >= 60:
    print("Result: PASS")
    print("Grade: C")

elif average >= 50:
    print("Result: PASS")
    print("Grade: D")

else:
    print("Result: FAIL")
    print("Grade: F")
